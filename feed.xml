---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet type="text/css" href="{{ '/assets/css/feed.css' | relative_url }}"?>
{% comment %}
  Copied from jekyll-feed 0.17.0's template (the plugin skips its own feed when
  this file exists) so the feed can carry a CSS stylesheet instead of XSLT,
  which browsers are removing. The h:* XHTML elements are only there for
  browsers to show; feed readers ignore foreign markup.
{% endcomment %}
<feed xmlns="http://www.w3.org/2005/Atom" xmlns:h="http://www.w3.org/1999/xhtml">
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ page.url | absolute_url | xml_escape }}</id>
  <title type="html">{{ site.title | smartify | xml_escape }}</title>
  {% if site.description %}
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  {% endif %}
  {% if site.author %}
  <author>
    <name>{{ site.author.name | default: site.author | xml_escape }}</name>
  </author>
  {% endif %}

  <!-- Browsers only: fit the styled feed to phone screens -->
  <h:meta name="viewport" content="width=device-width, initial-scale=1"/>

  <h:div class="zones" aria-hidden="true"><h:span>8</h:span><h:span>7</h:span><h:span>6</h:span><h:span>5</h:span><h:span>4</h:span><h:span>3</h:span><h:span>2</h:span><h:span>1</h:span></h:div>

  <h:div class="titleblock">
    <h:a class="tb-cell tb-title" href="{{ '/' | absolute_url }}"><h:span class="tb-label">Title</h:span><h:span class="tb-value">Huan Truong&#8217;s Pensieve</h:span></h:a>
    <h:div class="tb-cell tb-doc"><h:span class="tb-label">Doc. no.</h:span><h:span class="tb-value">TN-FEED</h:span></h:div>
    <h:div class="tb-cell tb-date"><h:span class="tb-label">Date</h:span><h:span class="tb-value">{{ site.posts.first.date | date: '%Y-%m-%d' }}</h:span></h:div>
    <h:div class="tb-nav">
      <h:a class="tb-cell" href="{{ '/' | absolute_url }}"><h:span class="tb-label">Sec. 1</h:span><h:span class="tb-value">Blog</h:span></h:a>
      <h:a class="tb-cell" href="{{ '/projects.html' | absolute_url }}"><h:span class="tb-label">Sec. 2</h:span><h:span class="tb-value">Projects</h:span></h:a>
      <h:a class="tb-cell" href="{{ '/about.html' | absolute_url }}"><h:span class="tb-label">Sec. 3</h:span><h:span class="tb-value">Bio</h:span></h:a>
      <h:a class="tb-cell tb-rss" href="{{ page.url | absolute_url }}" aria-current="page"><h:span class="tb-label">Sec. 4</h:span><h:span class="tb-value">RSS</h:span></h:a>
    </h:div>
    <h:div class="tb-cell tb-drawn"><h:span class="tb-label">Drawn by</h:span><h:span class="tb-value"><h:span class="tb-author">Huan Truong</h:span> <h:a href="https://github.com/{{ site.owner.github }}">Github</h:a> <h:a href="{{ '/vc' | absolute_url }}">vCard</h:a></h:span></h:div>
  </h:div>

  <h:div class="feed-intro">
    <h:div class="contents-head">
      <h:h1>RSS feed</h:h1>
      <h:p class="contents-meta">Latest {{ site.feed.posts_limit | default: 10 }} documents. <h:a href="{{ '/' | absolute_url }}">All documents &#8594;</h:a></h:p>
    </h:div>
    <h:p>This is the Atom feed for {{ site.title | xml_escape }}. To subscribe, paste this page&#8217;s address into your feed reader:</h:p>
    <h:p><h:code>{{ page.url | absolute_url }}</h:code></h:p>
  </h:div>

  {% assign posts = site.posts | where_exp: "post", "post.draft != true" %}
  {% assign posts_limit = site.feed.posts_limit | default: 10 %}
  {% for post in posts limit: posts_limit %}
  {% assign post_title = post.title | smartify | strip_html | normalize_whitespace | xml_escape %}
  <entry>
    <title type="html">{{ post_title }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html" title="{{ post_title }}" />
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <id>{{ post.id | absolute_url | xml_escape }}</id>
    <content type="html" xml:base="{{ post.url | absolute_url | xml_escape }}"><![CDATA[{{ post.content | strip }}]]></content>
    {% assign post_author = post.author | default: site.author %}
    {% assign post_author = site.data.authors[post_author] | default: post_author %}
    <author>
      <name>{{ post_author.name | default: post_author | default: "" | xml_escape }}</name>
    </author>
    {% if post.category %}
    <category term="{{ post.category | xml_escape }}" />
    {% endif %}
    {% for tag in post.tags %}
    <category term="{{ tag | xml_escape }}" />
    {% endfor %}
    {% assign post_summary = post.description | default: post.excerpt %}
    {% if post_summary and post_summary != empty %}
    <summary type="html"><![CDATA[{{ post_summary | strip_html | normalize_whitespace }}]]></summary>
    {% endif %}
    <h:div class="feed-row">
      <h:span class="feed-date">{{ post.date | date: '%b %Y' }}</h:span>
      <h:div class="feed-post">
        <h:a class="feed-title" href="{{ post.url | absolute_url }}">{{ post_title }}</h:a>
        {% if post_summary and post_summary != empty %}
        <h:p class="excerpt">{{ post_summary | strip_html | normalize_whitespace | truncatewords: 40 | xml_escape }}</h:p>
        {% endif %}
      </h:div>
    </h:div>
  </entry>
  {% endfor %}

  <h:div class="feed-end"><h:p class="end-mark">End of feed</h:p></h:div>
</feed>
