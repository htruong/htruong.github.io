---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet type="text/css" href="{{ '/assets/css/feed.css' | absolute_url }}"?>
{% comment %}
  Copied from jekyll-feed 0.17.0's template (the plugin skips its own feed when
  this file exists) so the feed can carry a CSS stylesheet instead of XSLT,
  which browsers are removing. The h:* XHTML elements are only there for
  browsers to show; feed readers ignore foreign markup.
{% endcomment %}
<feed xmlns="http://www.w3.org/2005/Atom" xmlns:h="http://www.w3.org/1999/xhtml">
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ page.url | absolute_url | xml_escape }}</id>
  <title type="html">{{ site.title | smartify | xml_escape }}</title>
  {% if site.description %}
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  {% endif %}
  {% if site.author %}
  <author>
    <name>{{ site.author.name | default: site.author | xml_escape }}</name>
  </author>
  {% endif %}

  <h:div class="intro">
    <h:div class="nav">
      <h:a href="{{ '/' | absolute_url }}">Blog</h:a>
      <h:a href="{{ '/projects.html' | absolute_url }}">Pro-<h:br/>jects</h:a>
      <h:a href="{{ '/about.html' | absolute_url }}">Bio</h:a>
      <h:a class="rss" href="{{ page.url | absolute_url }}">RSS</h:a>
    </h:div>
    <h:h2>RSS feed</h:h2>
    <h:p>This is the RSS feed for {{ site.title | xml_escape }}. To subscribe, paste this page's address into your feed reader:</h:p>
    <h:p><h:code>{{ page.url | absolute_url }}</h:code></h:p>
    <h:p>Latest posts below. <h:a href="{{ '/' | absolute_url }}">See all posts</h:a>.</h:p>
  </h:div>

  {% assign posts = site.posts | where_exp: "post", "post.draft != true" %}
  {% assign posts_limit = site.feed.posts_limit | default: 10 %}
  {% for post in posts limit: posts_limit %}
  {% assign post_title = post.title | smartify | strip_html | normalize_whitespace | xml_escape %}
  <entry>
    <title type="html">{{ post_title }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html" title="{{ post_title }}" />
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <id>{{ post.id | absolute_url | xml_escape }}</id>
    <content type="html" xml:base="{{ post.url | absolute_url | xml_escape }}"><![CDATA[{{ post.content | strip }}]]></content>
    {% assign post_author = post.author | default: site.author %}
    {% assign post_author = site.data.authors[post_author] | default: post_author %}
    <author>
      <name>{{ post_author.name | default: post_author | default: "" | xml_escape }}</name>
    </author>
    {% if post.category %}
    <category term="{{ post.category | xml_escape }}" />
    {% endif %}
    {% for tag in post.tags %}
    <category term="{{ tag | xml_escape }}" />
    {% endfor %}
    {% assign post_summary = post.description | default: post.excerpt %}
    {% if post_summary and post_summary != empty %}
    <summary type="html"><![CDATA[{{ post_summary | strip_html | normalize_whitespace }}]]></summary>
    {% endif %}
    <h:div class="row">
      <h:span class="post-date">{{ post.date | date: '%m/%Y' }}</h:span>
      <h:div class="post">
        <h:a href="{{ post.url | absolute_url }}">{{ post_title }}</h:a>
        {% if post_summary and post_summary != empty %}
        <h:p class="excerpt">{{ post_summary | strip_html | normalize_whitespace | truncatewords: 40 | xml_escape }}</h:p>
        {% endif %}
      </h:div>
    </h:div>
  </entry>
  {% endfor %}
</feed>
